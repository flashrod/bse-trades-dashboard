# ---------- API ----------
PORT=4000
DATABASE_URL=postgres://bse:bse@localhost:5433/bse
MOCK_URL=http://localhost:4001
# Comma separated. Use * to allow any origin.
FRONTEND_ORIGINS=http://localhost:5173

# Pull geometry: ~60 slices of 12h x ~80 rows = ~15 minutes at 180ms/row.
PULL_SLICE_HOURS=12
PULL_PAGE_LIMIT=80
PULL_REQUEST_TIMEOUT_MS=20000
PULL_MAX_ATTEMPTS=3
PULL_WINDOW_OVERLAP_MS=5000

# Start one pull when the API boots, but only if the tape is empty.
# This seeds a first run; it never fires again once trades exist.
AUTO_START_PULL=true
SSE_HEARTBEAT_MS=15000

# ---------- Mock BSE ----------
MOCK_PORT=4001
MOCK_SEED_COUNT=5000
# Simulated upstream throughput. 180ms/row => 5,000 rows ~= 15 minutes.
MOCK_MS_PER_ROW=180
# Hard connection cap, mirroring the corporate network.
MOCK_MAX_RESPONSE_MS=30000
# 0 = never fail. Set e.g. 0.05 to inject transient 503s.
MOCK_FAIL_RATE=0
MOCK_VERBOSE=false
